# Kopieer naar .env.production en vul in. Dit bestand staat buiten Git.
#
# Compose leest dit bestand voor de substituties in compose.yaml, maar geeft het
# niet als geheel aan de containers: per service staat uitgeschreven wat erin
# terechtkomt. De kolom hieronder zegt wie wat te zien krijgt.

# --- reverse proxy -------------------------------------------------------
# De web-container luistert op 127.0.0.1:WEB_HOST_PORT. Wijs je nginx (of een
# andere proxy op de host) daarheen. Alleen loopback: de container hoort niet
# rechtstreeks aan het internet.
WEB_HOST_PORT=3002

# Alleen nodig als je Caddy als proxy gebruikt in plaats van nginx; die start
# uitsluitend met `--profile caddy`.
DOMAIN=training.jaspervanzeir.be
ACME_EMAIL=you@example.com

# --- web (en de browser) -------------------------------------------------
# Publiek. Wordt tijdens de Next-build ingebakken en is ook server-side nodig.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# De publieke helft van het VAPID-paar voor push-meldingen. Hoort in de browser
# en is geen geheim. De private helft staat als secret bij de Edge Function
# send-push; zie docs/push-notifications.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_me

# --- web + worker --------------------------------------------------------
# De coachchat draait als server action in de web-container, de coach-engine in
# de worker. Allebei hebben ze deze sleutel nodig.
ANTHROPIC_API_KEY=replace_me

# --- alleen worker -------------------------------------------------------
# De service-role key omzeilt alle RLS en komt daarom bewust niet in de
# web-container, die als enige aan het internet hangt.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
FIT_BUCKET=garmin-fit
GARMIN_THROTTLE_S=0.7

# Map op de VPS met garmin_tokens.json en tm_login_stamp.json.
GARMIN_TOKENSTORE_HOST=./secrets/garminconnect

# Jouw tijdzone. Bepaalt welke dag "vandaag" is en wanneer het dichte
# ochtendvenster loopt. De VPS draait in UTC; zonder dit klopt geen van beide.
TM_TIMEZONE=Europe/Brussels
