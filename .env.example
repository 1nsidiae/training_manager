# Kopieer naar .env en vul aan. .env staat in .gitignore.

# Supabase — project training_manager (eu-west-1)
SUPABASE_URL=https://jyyrbjaavvlfhgtpintg.supabase.co

# Service role key: Supabase dashboard -> Project Settings -> API Keys -> service_role
# Deze key omzeilt RLS. Alleen server-side gebruiken, nooit in de PWA.
SUPABASE_SERVICE_ROLE_KEY=

# Garmin OAuth-tokens (aangemaakt door scripts/garmin_login.py)
GARMIN_TOKENSTORE=~/.garminconnect

# Storage bucket voor gearchiveerde FIT-bestanden
FIT_BUCKET=garmin-fit

# Seconden tussen Garmin-calls. Niet lager zetten: het is een unofficiele API.
GARMIN_THROTTLE_S=0.7

# Anthropic API-key voor de coach-engine (console.anthropic.com)
ANTHROPIC_API_KEY=
